FROM mcr.microsoft.com/windows/servercore:ltsc2022

RUN curl "https://go.microsoft.com/fwlink/?LinkID=2344626" -L -o sqlserver-install.exe
RUN .\sqlserver-install.exe /ACTION="install" /IACCEPTSQLSERVERLICENSETERMS /QUIET /VERBOSE

# Enable TCP/IP via registry                   
RUN powershell -Command "Set-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Microsoft SQL Server\MSSQL17.MSSQLSERVER\MSSQLServer\SuperSocketNetLib\Tcp' -Name 'Enabled' -Value 1"
# Start the service automatically
RUN sc.exe config MSSQLSERVER start= auto    

CMD ping -t localhost > NUL